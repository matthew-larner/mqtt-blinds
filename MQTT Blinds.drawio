        <mxCell id="_eBOtiYvHq5mVtx5obwK-1" value="MQTT connection" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;fontStyle=1;align=left;spacing=3.8;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=xwngpCG23Qxo;" vertex="1" parent="1">
