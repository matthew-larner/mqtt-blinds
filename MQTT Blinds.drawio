        <UserObject label="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:25.7px;font-weight: bold;&quot;&gt;message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt; &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;{&#xa;  &quot;name&quot;: &quot;Bed 1 Roller Blind&quot;,&#xa;  &quot;unique_id&quot;: &quot;bed_1_roller_blind&quot;,&#xa;  &quot;command_topic&quot;: &quot;mqtt-blinds/bed_1_roller_blind/set&quot;,&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt;&quot;position_topic&quot;: &lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&quot;mqtt-blinds/bed_1_roller_blind/position&quot;,&lt;/span&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt;&#xa;&quot;set_position_topic&quot;: &lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&quot;mqtt-blinds/bed_1_roller_blind/position/set&quot;,&#xa;  &quot;schema&quot;: &quot;json&quot;,&#xa;  &quot;availability_topic&quot;: &quot;mqtt-blinds/available&quot;,&#xa;  &quot;device_class&quot;: &quot;blind&quot;,&#xa;&quot;&lt;/span&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt;position_template&quot;: &quot;% value %&quot;,&#xa;  &quot;payload_open&quot;: &quot;open&quot;,&#xa;  &quot;payload_close&quot;: &quot;close&quot;,&#xa;  &quot;position_open&quot;: 0,&#xa;  &quot;position_closed&quot;: 100,&#xa;  &quot;payload_stop&quot;: null&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;}&#xa;&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;font-weight: bold;&quot;&gt;Where:&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt; &#xa;- Name is the name from configuration.yml&#xa;-unique_id = name from configuration.yml converted to lowercase &amp; snake_case&#xa;- command_topic= &amp;lt;mqtt.topic_prefix&amp;gt;/{unique_id}/set&#xa;- position_topic =  &amp;lt;mqtt.topic_prefix&amp;gt;/{unique_id}/position&#xa;- set_position_topic = &amp;lt;mqtt.topic_prefix&amp;gt;/{unique_id}/position/set &#xa;- availability_topic = from mqtt.availability_topic in config&#xa;- device_class: if blinds.type=&#39;blind&#39; use &#39;blind&#39;, if blinds.type=&#39;curtain&#39; use &#39;awning&#39;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt; &quot;payload_stop&quot;: &lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;if blinds.type=&#39;blind&#39; use null, if blinds.type=&#39;curtain&#39; use &quot;stop&quot;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt;&lt;span style=&quot;font-size:8.5px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:8.5px;color:#e81313;&quot;&gt; &quot;payload_open&quot;: if reverse_direction=false-&amp;gt; &quot;open&quot; else &quot;close&quot;,&#xa;  &quot;payload_close&quot;: if reverse_direction=false-&amp;gt; &quot;close&quot; else &quot;open&quot;,&#xa;  &quot;position_open&quot;: if reverse_direction=false-&amp;gt; 0 else 100,&#xa;  &quot;position_closed&quot;: if reverse_direction=false-&amp;gt; 100 else 0,&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;font-weight: bold;&quot;&gt;USE:&#xa;&lt;/span&gt;&#39;qos&#39; &amp; &#39;retain&#39; properties from config -&amp;gt; mqtt&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" placeholders="1" id="_eBOtiYvHq5mVtx5obwK-85">
          <mxCell style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=~wng_KCOe3uH;" vertex="1" parent="1">
            <mxGeometry x="908" y="1950" width="405" height="405" as="geometry" />
