        <mxCell id="_eBOtiYvHq5mVtx5obwK-62" value="If hub_communication.async=true then don&#39;t queue up TCP commands. You can send them all concurrently.&#xa;&#xa;If hub_communication.async=false then queue up TCP commands. Send next command when either:&#xa;- a TCP response has been received or;&#xa;- {tcp.timeout} seconds have passed" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#9391ff;strokeWidth=0;lucidId=-OvMXEtYcyjx;" vertex="1" parent="1">
