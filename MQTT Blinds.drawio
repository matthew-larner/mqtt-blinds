        </mxCell>
        <mxCell id="_eBOtiYvHq5mVtx5obwK-2" value="We want to emit a LWT message on a topic when this service goes offline/online. The topic to use is from mqtt.availability_topic in the config. The message should be &#39;online&#39; if the service is online and &#39;offline&#39; if the service is offline." style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=16.6;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=xwngF7py4aw2;" vertex="1" parent="1">
          <mxGeometry x="83" y="963" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="_eBOtiYvHq5mVtx5obwK-3" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.6px;&quot;&gt;This can be specified in the connect string. .e.g. &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;var&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; mqtt    &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; require(&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;mqtt&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;); &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;var&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; client  &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; mqtt.connect(&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;mqtt://broker.mqttdashboard.com&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,{   will&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; {     topic&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;inception/available&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     payload; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;offline&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     qos&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#40a070;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     retain&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;true&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;   } });&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=xwngTZr76bg.;" vertex="1" parent="1">
